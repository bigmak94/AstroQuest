<?xml version="1.0" encoding="utf-8"?>
<!--
  Immersive OpenXR host for the shadPS4 ARM64 core on Meta Quest. The manifest follows Meta's
  "Android Manifest Settings" page for native apps (activity attributes, VR intent category,
  head-tracking feature, supported devices) plus what the Khronos OpenXR loader needs to find
  the runtime (permissions and queries, copied from openxr_loader_for_android's own manifest).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.astrobotquest.vrhost"
    android:versionCode="21"
    android:versionName="0.21"
    android:installLocation="auto">

    <uses-sdk
        android:minSdkVersion="32"
        android:targetSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature
        android:glEsVersion="0x00030001"
        android:required="true" />

    <!--
      The game is played with a gamepad, held in hands the headset tracks, or with the
      headset's own controllers. Declaring hand tracking tells Horizon OS that those
      controllers are not needed; without it the launch is blocked by a "controllers required"
      dialog whenever they are asleep.
    -->
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- Lets the app see a paired DualSense's rumble motors. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      The game listens to the headset's microphone (blowing at things in its world), as it did
      to PlayStation VR's. Asked for when the app starts; without it the game hears silence.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Development aid, see SandboxShell.java. -->
    <instrumentation
        android:name="com.astrobotquest.vrhost.SandboxShell"
        android:targetPackage="com.astrobotquest.vrhost" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <!--
      extractNativeLibs: the glibc dynamic loader ships as lib/arm64-v8a/libastro_ld.so and has to
      exist as a real file the app may execute.
    -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:appCategory="game">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|quest3s" />
        <!-- The hands are followed to place the controller they hold: as often as possible. -->
        <meta-data
            android:name="com.oculus.handtracking.frequency"
            android:value="HIGH" />

        <activity
            android:name="com.astrobotquest.vrhost.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
